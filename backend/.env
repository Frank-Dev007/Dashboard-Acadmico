DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dashboard_academico
DB_DIALECT=mysql
DB_PORT=3306
PORT=4000

# ── Moodle / Cintia ────────────────────────────────────────────────────────────
# URL base de tu Moodle (sin barra al final)
MOODLE_URL=http://localhost

# Nombre del servicio web habilitado en Moodle
# (Administración del sitio → Plugins → Web services → Servicios externos)
MOODLE_SERVICE=moodle_mobile_app

# Token de administrador para consultar perfiles de usuarios
# (Administración del sitio → Plugins → Web services → Administrar tokens)
MOODLE_ADMIN_TOKEN=fb6421a8e5a448099f6e2d97f6bffa03

# true  → el username en Moodle es el correo completo (ej: juan@uni.edu.co)
# false → el username es la parte antes del @ (ej: juan)  ← valor por defecto
MOODLE_USERNAME_FROM_EMAIL=false
